{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermod", "version": "0.3.1", "identifier": "org.hermod.transfer",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://localhost:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows":[{"label":"main","title":"Hermod","width":1120,"height":840,"minWidth":360,"minHeight":600,"dragDropEnabled":true}],
    "security":{"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active":true,"targets":["appimage"],"category":"Utility",
    "shortDescription":"Private, direct IPv6 file transfer",
    "icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "macOS":{"minimumSystemVersion":"12.0","signingIdentity":"-"},
    "android":{"minSdkVersion":24}
  }
}
